# Add any of these. With more than one, OpenForge uses them as a team:
# Claude builds, the others plan and review. You can also enter keys in the web app instead.

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

OPENAI_API_KEY=
# OPENAI_MODEL=        # leave empty to use the newest GPT model your key can access

GEMINI_API_KEY=
# GEMINI_MODEL=        # leave empty to use the newest Gemini Pro model

# Free local models with Ollama (https://ollama.com) or LM Studio, or any OpenAI-compatible API such as OpenRouter.
# LOCAL_BASE_URL=http://localhost:11434/v1
# LOCAL_MODEL=qwen3-coder
# LOCAL_API_KEY=

# Set to 1 to try OpenForge with a built-in demo model and no keys.
# OPENFORGE_DEMO=1

# PORT=4321
